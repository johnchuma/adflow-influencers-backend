<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Invoice Notification</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <style>
    span {
      color: #3bd780;
      text-decoration: underline;
    }
    @media (max-width: 500px) {
      img {
        height: 20px;
      }
      h1 {
        font-size: 18px;
      }
    }
  </style>
  <body>
    <div
      style="
        background-color: #f3f4f6;
        padding: 20px;
        color: #4b5563;
        font-family: 'Inter', sans-serif;
      "
    >
      <div
        class="container"
        style="background-color: white; border-radius: 8px; padding: 30px"
      >
        <a href="https://www.adflow.africa" target="_blank">
          <img style="height: 35px" src="https://adflow.africa/logo.png" />
        </a>

        <div id="heading">
          <h1 style="color: #222d38">New Invoice Submitted</h1>
        </div>
        <p style="font-size: 14px">Hi <%- name %>!</p>

        <p style="font-size: 14px">
          A new invoice has been submitted for campaign
          <strong><%- campaignName %></strong>.
        </p>

        <div
          style="
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 16px;
            margin: 16px 0;
          "
        >
          <table style="width: 100%; font-size: 14px">
            <tr>
              <td style="padding: 4px 0; color: #6b7280">Campaign:</td>
              <td style="padding: 4px 0; font-weight: 600">
                <%- campaignName %>
              </td>
            </tr>
            <tr>
              <td style="padding: 4px 0; color: #6b7280">Influencer:</td>
              <td style="padding: 4px 0; font-weight: 600">
                <%- influencerName %>
              </td>
            </tr>
            <tr>
              <td style="padding: 4px 0; color: #6b7280">Amount:</td>
              <td style="padding: 4px 0; font-weight: 600; color: #059669">
                TSH <%- amount %>
              </td>
            </tr>
          </table>
        </div>

        <p style="font-size: 14px">
          Please review and process this invoice at your earliest convenience.
        </p>

        <a
          href="https://dashboard.adflow.africa"
          target="_blank"
          style="
            display: inline-block;
            background-color: #4f46e5;
            color: white;
            padding: 10px 24px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            margin-top: 8px;
          "
        >
          View Pipeline
        </a>

        <p style="font-size: 14px; margin-top: 20px">Thanks</p>
      </div>
      <div style="padding: 20px; font-size: 12px; color: #9ca3af">
        <p>
          This email was sent to <span><%- email %></span>. If you'd rather not
          receive this kind of email, you can <span>unsubscribe</span> or
          <span>manage your email preferences.</span>
        </p>
        <p>House No 346 Senga RD, Mikocheni, Dar es salaam</p>

        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          style="width: 100%; table-layout: fixed"
        >
          <tr>
            <td style="text-align: left; vertical-align: middle; padding: 0">
              <img
                src="https://adflow.africa/favicon.ico"
                alt="AdFlow Logo"
                style="height: 30px; display: block"
              />
            </td>
            <td style="text-align: right; vertical-align: middle; padding: 0">
              <a href="#" target="_blank" style="text-decoration: none">
                <img
                  src="https://adflow.africa/twitter.png"
                  alt="Twitter"
                  style="height: 20px; display: inline-block; margin-left: 10px"
                />
              </a>
              <a
                href="https://www.linkedin.com/company/adflow-africa/"
                target="_blank"
                style="text-decoration: none"
              >
                <img
                  src="https://adflow.africa/linkedin.png"
                  alt="LinkedIn"
                  style="height: 20px; display: inline-block; margin-left: 10px"
                />
              </a>
              <a
                href="https://www.instagram.com/adflow.africa/"
                target="_blank"
                style="text-decoration: none"
              >
                <img
                  src="https://adflow.africa/instagram.png"
                  alt="Instagram"
                  style="height: 20px; display: inline-block; margin-left: 10px"
                />
              </a>
            </td>
          </tr>
        </table>
      </div>
    </div>
  </body>
</html>
